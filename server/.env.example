# Server runtime configuration. Do not commit server/.env.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL only. Replace values locally; never expose this value to the client.
DATABASE_URL=postgresql://trace_app:replace-with-a-password@localhost:5432/trace?schema=public

# Integration-test database. Must be separate from DATABASE_URL.
TEST_DATABASE_URL=postgresql://trace_app:replace-with-a-password@localhost:5432/trace_test?schema=public

# Embeddings are off by default. Select openai or gemini and add its key only
# when you deliberately want external embedding requests at runtime.
EMBEDDING_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Gemini is also opt-in. This project sends no content until you set provider=gemini
# and explicitly trigger source embedding or semantic search.
GEMINI_API_KEY=replace-with-your-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Generation is independently opt-in. It reuses GEMINI_API_KEY only after an
# explicit Analyze request; embedding configuration alone never enables it.
GENERATION_PROVIDER=disabled
GEMINI_GENERATION_MODEL=gemini-2.5-flash
